+[package]
+name = "horizon-steam"
+version = "0.1.0"
+edition = "2024"
+license = "MIT"
+description = "Play with Steam friends: e4steam's Steam P2P multiplayer, ported to Horizon (a lobby carries the invite, Steam networking sockets carry the game)"
+
+[dependencies]
+horizon-protocol = { path = "../horizon-protocol" }
+# Safe Steamworks bindings (SDK 1.59+): the client, matchmaking, networking
+# sockets and the callbacks this crate pumps. Linked against the SDK
+# redistributable the crate bundles, so the game needs steam_api beside it
+# only when the `steam` feature of horizon-client is on.
+steamworks = { version = "0.13", default-features = false, features = ["raw-bindings"] }
+log = "0.4"
+
+[lints]
+workspace = true
diff --git a/crates/horizon-steam/src/guard.rs b/crates/horizon-steam/src/guard.rs
new file mode 100644
index 000000000..a31518d80
--- /dev/null
+++ b/crates/horizon-steam/src/guard.rs
@@ -0,0 +1,239 @@
+//! The host's check on a guest over Steam: the login name the guest's client
+//! sends must be the safe name of the Steam account the P2P connection is
+//! authenticated as. e4steam derives the guest's identity on the host from
+//! the SteamID and never trusts the connecting client; without the JVM to
+//! swap the profile, this port checks instead: the guest's own client sends
+//! its Steam-derived name ([identity::safe_name](crate::identity::safe_name)),
+//! and a guest that logs in as anything else is refused before a byte of its
+//! stream reaches the integrated server.
+//!
+//! The check reads the guest's first two packets (the handshake's Intention,
+//! then the login's Hello, both uncompressed plaintext before the server
+//! answers) straight from the Steam connection. Anything malformed is
+//! refused: only Horizon's own client joins this way.
+
+use crate::identity;
+
+/// How many bytes of the guest's opening the check reads at most: the two
+/// packets together are a few dozen bytes; anything past this is not a
+/// Horizon join.
+const MAX_OPENING: usize = 1024;
+
+/// What the check found in the guest's opening.
+#[derive(Debug)]
+pub enum Verdict {
+    /// The name carries a SteamID; the caller compares it with the
+    /// connection's. The name is included for the comparison.
+    Allowed(String),
+    /// Not a Horizon join, or the name is not a Steam identity: refuse.
+    Refused(&'static str),
+}
+
+/// A feed of the guest's first bytes, ending in the verdict.
+#[derive(Default)]
+pub struct Opening {
+    buf: Vec<u8>,
+}
+
+impl Opening {
+    /// The next bytes of the guest's opening (hand them over as they arrive).
+    /// Returns the verdict once the Hello's name has been read, `Err(true)`
+    /// while more bytes are wanted (the caller goes on feeding), and
+    /// `Err(false)` when the opening is malformed or too long.
+    pub fn feed(&mut self, bytes: &[u8]) -> Result<Verdict, bool> {
+        if self.buf.len() + bytes.len() > MAX_OPENING {
+            return Err(false);
+        }
+        self.buf.extend_from_slice(bytes);
+        let mut cursor = 0;
+        // Intention: the handshake's first packet. Only a login intent goes on.
+        let (id, body_end, rest) = packet(&self.buf, cursor).ok_or(false)?;
+        if id != 0 {
+            return Err(false);
+        }
+        cursor = body_end;
+        match Intention::read(rest) {
+            Some(intent) if intent.login => {}
+            _ => return Err(false),
+        }
+        // Hello: the login's first packet, carrying the name.
+        let (id, _, rest) = packet(&self.buf, cursor).ok_or(false)?;
+        if id != 0 {
+            return Err(false);
+        }
+        let Some(hello) = Hello::read(rest) else {
+            return Err(false);
+        };
+        match identity::steam_id_of(&hello.name) {
+            Some(_) => Ok(Verdict::Allowed(hello.name)),
+            None => Ok(Verdict::Refused(
+                "the guest's login name is not a Steam identity",
+            )),
+        }
+    }
+}
+
+/// One packet from `buf[cursor..]`: its id, where the packet ends (an index
+/// into the whole buffer) and the body. `None` while the whole packet hasn't
+/// arrived.
+fn packet(buf: &[u8], cursor: usize) -> Option<(i32, usize, &[u8])> {
+    let (length, header) = varint(&buf[cursor..])?;
+    if !(0..=4096).contains(&length) {
+        return None;
+    }
+    let end = cursor + header + length as usize;
+    if buf.len() < end {
+        return None;
+    }
+    let (id, id_len) = varint(&buf[cursor + header..end])?;
+    Some((id, end, &buf[cursor + header + id_len..end]))
+}
+
+/// The handshake's Intention: protocol, host, port, next state.
+struct Intention {
+    login: bool,
+}
+
+impl Intention {
+    fn read(body: &[u8]) -> Option<Self> {
+        let (_, used) = varint(body)?; // protocol version
+        let rest = &body[used..];
+        let (host_len, used) = varint(rest)?;
+        if host_len < 0 || rest.len() < used + host_len as usize + 3 {
+            return None;
+        }
+        let rest = &rest[used + host_len as usize..];
+        let (state, _) = varint(&rest[2..])?; // past the port
+        Some(Self { login: state == 2 })
+    }
+}
+
+/// The login's Hello: the player's name (and the client's uuid, which the
+/// offline server ignores).
+struct Hello {
+    name: String,
+}
+
+impl Hello {
+    fn read(body: &[u8]) -> Option<Self> {
+        let (len, used) = varint(body)?;
+        if len < 0 || body.len() < used + len as usize {
+            return None;
+        }
+        let name = String::from_utf8(body[used..used + len as usize].to_vec()).ok()?;
+        if name.chars().count() > 16 {
+            return None;
+        }
+        Some(Self { name })
+    }
+}
+
+/// A protocol varint: the value and how many bytes it took.
+fn varint(buf: &[u8]) -> Option<(i32, usize)> {
+    let mut value = 0i32;
+    for (i, &b) in buf.iter().take(5).enumerate() {
+        value |= i32::from(b & 0x7f) << (i * 7);
+        if b & 0x80 == 0 {
+            return Some((value, i + 1));
+        }
+    }
+    None
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn put_varint(mut value: i32, out: &mut Vec<u8>) {
+        loop {
+            let byte = (value & 0x7f) as u8;
+            value = ((value as u32) >> 7) as i32;
+            if value == 0 {
+                out.push(byte);
+                return;
+            }
+            out.push(byte | 0x80);
+        }
+    }
+
+    fn put_string(s: &str, out: &mut Vec<u8>) {
+        put_varint(s.len() as i32, out);
+        out.extend_from_slice(s.as_bytes());
+    }
+
+    fn frame(id: i32, body: &[u8]) -> Vec<u8> {
+        let mut out = Vec::new();
+        put_varint(body.len() as i32 + 1, &mut out); // + the packet id
+        put_varint(id, &mut out);
+        out.extend_from_slice(body);
+        out
+    }
+
+    /// Intention (login) and Hello packets as Horizon's client sends them.
+    fn opening(name: &str) -> Vec<u8> {
+        let mut handshake = Vec::new();
+        put_varint(763, &mut handshake);
+        put_string("127.0.0.1", &mut handshake);
+        handshake.extend_from_slice(&25565u16.to_be_bytes());
+        put_varint(2, &mut handshake); // next state: login
+        let mut hello = Vec::new();
+        put_string(name, &mut hello);
+        hello.extend_from_slice(&[0u8; 16]); // the client's uuid
+        [frame(0, &handshake), frame(0, &hello)].concat()
+    }
+
+    fn verdict(name: &str) -> Result<Verdict, bool> {
+        let mut check = Opening::default();
+        check.feed(&opening(name))
+    }
+
+    #[test]
+    fn a_steam_safe_name_passes() {
+        assert!(matches!(
+            verdict("s_kxuogshzmyo"),
+            Ok(Verdict::Allowed(name)) if name == "s_kxuogshzmyo"
+        ));
+    }
+
+    #[test]
+    fn any_other_name_is_refused() {
+        for name in ["Steve", "host", "s_"] {
+            assert!(
+                matches!(verdict(name), Ok(Verdict::Refused(_))),
+                "{name} was not refused"
+            );
+        }
+    }
+
+    #[test]
+    fn bytes_arriving_in_pieces_still_parse() {
+        let bytes = opening("s_3dk6el9t85j");
+        let mut check = Opening::default();
+        let mut verdict = Err(true);
+        for chunk in bytes.chunks(3) {
+            verdict = check.feed(chunk);
+            if verdict.is_ok() {
+                break;
+            }
+        }
+        assert!(matches!(verdict, Ok(Verdict::Allowed(_))));
+    }
+
+    #[test]
+    fn a_status_ping_is_not_a_join() {
+        // next state 1: the client asks the server's status, it isn't joining.
+        let mut handshake = Vec::new();
+        put_varint(763, &mut handshake);
+        put_string("127.0.0.1", &mut handshake);
+        handshake.extend_from_slice(&25565u16.to_be_bytes());
+        put_varint(1, &mut handshake);
+        let mut check = Opening::default();
+        assert!(matches!(check.feed(&frame(0, &handshake)), Err(false)));
+    }
+
+    #[test]
+    fn garbage_is_refused_without_hanging() {
+        let mut check = Opening::default();
+        assert!(matches!(check.feed(&[0xff; 40]), Err(false)));
+    }
+}
diff --git a/crates/horizon-steam/src/guest.rs b/crates/horizon-steam/src/guest.rs
new file mode 100644
index 000000000..405d64fc2
--- /dev/null
+++ b/crates/horizon-steam/src/guest.rs
@@ -0,0 +1,269 @@
+//! The guest's end: join the host's lobby, check it is a Horizon world of
+//! this game's version, connect to the host over Steam's P2P network, then
+//! offer the session on a loopback port the client connects to like to any
+//! server. Joining logs in as this player's own Steam identity
+//! ([identity](crate::identity)); the host's check ([guard](crate::guard))
+//! expects exactly that.
+use crate::VIRTUAL_PORT;
+use std::{
+    fmt, io,
+    net::{Ipv4Addr, TcpListener, TcpStream},
+    thread::JoinHandle,
+    time::{Duration, Instant},
+};
+use steamworks::networking_sockets::NetConnection;
+use steamworks::networking_types::{
+    AppNetConnectionEnd, NetConnectionEnd, NetworkingConnectionState, NetworkingIdentity,
+};
+use steamworks::{LobbyId, SteamId};
+
+/// How a join is set up.
+pub struct GuestConfig {
+    /// The lobby as pasted: a `steam:<id>` address, or the bare id.
+    pub lobby: String,
+    /// This game's protocol number: a lobby whose protocol differs is
+    /// refused before connecting, as the friends relay refuses a guest.
+    pub protocol: i32,
+    /// This game's version name, for the mismatch message.
+    pub game: String,
+}
+
+/// Why joining failed, in words for the player.
+#[derive(Debug)]
+pub enum JoinError {
+    /// Steam isn't running or refused the game.
+    NoSteam(String),
+    /// Not a `steam:<id>` address.
+    BadAddress,
+    /// No lobby with this id, or it ended.
+    LobbyGone,
+    /// The lobby holds no Horizon metadata: it belongs to another program on
+    /// the shared App ID 480, as e4steam filters its own traffic.
+    NotHorizon,
+    /// The host's world is another game version.
+    VersionMismatch {
+        host: Option<String>,
+        mine: String,
+    },
+    /// The lobby is full.
+    Full,
+    /// The host's game didn't take the connection.
+    HostUnreachable,
+    Failed(String),
+}
+impl fmt::Display for JoinError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::NoSteam(e) => write!(f, "{e}"),
+            Self::BadAddress => write!(
+                f,
+                "That's not a Steam world's address: it should be steam: followed by a number from your friend's Play with Friends screen."
+            ),
+            Self::LobbyGone => write!(
+                f,
+                "No Steam world uses this address. Check it, or ask your friend to start sharing again."
+            ),
+            Self::NotHorizon => write!(
+                f,
+                "This Steam lobby isn't a Horizon world. Check the address."
+            ),
+            Self::VersionMismatch {
+                host: Some(v),
+                mine,
+            } => {
+                write!(f, "Your friend plays Minecraft {v}; you have {mine}.")
+            }
+            Self::VersionMismatch { host: None, mine } => {
+                write!(
+                    f,
+                    "Your friend plays another version of Minecraft than {mine}."
+                )
+            }
+            Self::Full => write!(f, "Your friend's world is full."),
+            Self::HostUnreachable => write!(f, "Your friend's game didn't answer."),
+            Self::Failed(e) => write!(f, "Couldn't connect to your friend ({e})."),
+        }
+    }
+}
+impl std::error::Error for JoinError {}
+
+/// A settled session: the Steam connection carrying the game.
+pub struct Tunnel {
+    conn: NetConnection,
+}
+
+/// Join the lobby of the address: read the host's metadata, connect, wait
+/// for Steam to route the two. Blocks for a few seconds.
+pub fn join(config: &GuestConfig) -> Result<Tunnel, JoinError> {
+    let steam = crate::acquire().map_err(JoinError::NoSteam)?;
+    let id = crate::parse_lobby_address(config.lobby.trim())
+        .or_else(|| config.lobby.trim().parse().ok())
+        .ok_or(JoinError::BadAddress)?;
+    let client = steam.client();
+    let (joined, joined_rx) = std::sync::mpsc::channel();
+    client
+        .matchmaking()
+        .join_lobby(LobbyId::from_raw(id), move |r| {
+            let _ = joined.send(r);
+        });
+    let lobby = joined_rx
+        .recv_timeout(Duration::from_secs(10))
+        .map_err(|_| JoinError::Failed("Steam didn't answer the join".into()))?
+        .map_err(|_| JoinError::LobbyGone)?;
+    let mm = client.matchmaking();
+    // The lobby's own metadata says whether it is a Horizon world at all and
+    // whether it is this game's version: on the shared App ID 480 that is
+    // what keeps another program's lobby out, as e4steam filters its traffic.
+    let protocol = mm.lobby_data(lobby, crate::LOBBY_KEY_PROTOCOL);
+    let Some(protocol) = protocol.and_then(|p| p.parse::<i32>().ok()) else {
+        mm.leave_lobby(lobby);
+        return Err(JoinError::NotHorizon);
+    };
+    if protocol != config.protocol {
+        mm.leave_lobby(lobby);
+        return Err(JoinError::VersionMismatch {
+            host: mm.lobby_data(lobby, crate::LOBBY_KEY_GAME),
+            mine: config.game.clone(),
+        });
+    }
+    let host = mm
+        .lobby_data(lobby, crate::LOBBY_KEY_HOST)
+        .and_then(|h| h.parse::<u64>().ok())
+        .filter(|h| *h != 0)
+        .unwrap_or_else(|| mm.lobby_owner(lobby).raw());
+    if mm
+        .lobby_member_limit(lobby)
+        .is_some_and(|limit| mm.lobby_member_count(lobby) >= limit)
+    {
+        mm.leave_lobby(lobby);
+        return Err(JoinError::Full);
+    }
+    let conn = client
+        .networking_sockets()
+        .connect_p2p(
+            NetworkingIdentity::new_steam_id(SteamId::from_raw(host)),
+            VIRTUAL_PORT,
+            [],
+        )
+        .map_err(|_| {
+            mm.leave_lobby(lobby);
+            JoinError::HostUnreachable
+        })?;
+    // Steam finds the route (direct when it can, Valve's relays when not);
+    // the host's answer completes it.
+    let deadline = Instant::now() + Duration::from_secs(15);
+    loop {
+        match conn.try_receive_event() {
+            Some(event) => match event.new_state {
+                NetworkingConnectionState::Connected => break,
+                NetworkingConnectionState::ClosedByPeer
+                | NetworkingConnectionState::ProblemDetectedLocally
+                | NetworkingConnectionState::None => {
+                    mm.leave_lobby(lobby);
+                    return Err(JoinError::HostUnreachable);
+                }
+                _ => {}
+            },
+            None => {
+                if Instant::now() > deadline {
+                    mm.leave_lobby(lobby);
+                    return Err(JoinError::HostUnreachable);
+                }
+                std::thread::sleep(Duration::from_millis(10));
+            }
+        }
+    }
+    // The host checks that we log in as our own Steam identity: the login
+    // name is decided here, in net.rs, from the same derivation.
+    Ok(Tunnel { conn })
+}
+
+impl Tunnel {
+    /// Offer the session on `127.0.0.1:port` for one connection (the game's
+    /// client), as the friends tunnel does; the returned thread ends when
+    /// that connection does.
+    pub fn serve_loopback(self) -> io::Result<(u16, JoinHandle<()>)> {
+        let listener = TcpListener::bind((Ipv4Addr::LOCALHOST, 0))?;
+        let port = listener.local_addr()?.port();
+        listener.set_nonblocking(true)?;
+        let thread = std::thread::Builder::new()
+            .name("horizon-steam-guest".into())
+            .spawn(move || {
+                let deadline = Instant::now() + Duration::from_secs(30);
+                let plain = loop {
+                    match listener.accept() {
+                        Ok((s, from)) if from.ip().is_loopback() => break Some(s),
+                        Ok(_) => {}
+                        Err(e) if e.kind() == io::ErrorKind::WouldBlock => {
+                            if Instant::now() > deadline {
+                                break None;
+                            }
+                            std::thread::sleep(Duration::from_millis(10));
+                        }
+                        Err(_) => break None,
+                    }
+                };
+                drop(listener);
+                let mut conn = self.conn;
+                let Some(mut plain) = plain else {
+                    let _ = conn.close(
+                        NetConnectionEnd::App(AppNetConnectionEnd::generic_normal()),
+                        None,
+                        false,
+                    );
+                    return;
+                };
+                let _ = plain.set_nodelay(true);
+                carry(&mut conn, &mut plain);
+            })?;
+        Ok((port, thread))
+    }
+}
+
+/// The pump: Steam messages to the game's client, its bytes to Steam, until
+/// either side ends. Both sides are polled (a blocking read could sit on one
+/// while the other side's answer waits), a millisecond when idle.
+fn carry(conn: &mut NetConnection, plain: &mut TcpStream) {
+    use std::io::{Read, Write};
+    let _ = plain.set_nonblocking(true);
+    let mut buf = vec![0u8; 32 * 1024];
+    loop {
+        let mut idle = true;
+        if let Ok(messages) = conn.receive_messages(64) {
+            for message in messages {
+                if plain.write_all(message.data()).is_err() {
+                    return;
+                }
+                idle = false;
+            }
+        }
+        if let Some(event) = conn.try_receive_event()
+            && matches!(
+                event.new_state,
+                NetworkingConnectionState::ClosedByPeer
+                    | NetworkingConnectionState::ProblemDetectedLocally
+                    | NetworkingConnectionState::None
+            )
+        {
+            return;
+        }
+        match plain.read(&mut buf) {
+            Ok(0) => return,
+            Ok(n) => {
+                let Ok(_) = conn.send_message(
+                    &buf[..n],
+                    steamworks::networking_types::SendFlags::RELIABLE
+                        | steamworks::networking_types::SendFlags::NO_NAGLE,
+                ) else {
+                    return;
+                };
+                idle = false;
+            }
+            Err(e) if e.kind() == io::ErrorKind::WouldBlock => {}
+            Err(_) => return,
+        }
+        if idle {
+            std::thread::sleep(Duration::from_millis(1));
+        }
+    }
+}
diff --git a/crates/horizon-steam/src/identity.rs b/crates/horizon-steam/src/identity.rs
new file mode 100644
index 000000000..da6233ffc
--- /dev/null
+++ b/crates/horizon-steam/src/identity.rs
@@ -0,0 +1,117 @@
+//! The Minecraft identity of a Steam account, as e4steam 0.3.0 derives it
+//! (`SteamMinecraftIdentity`): a stable UUID and a safe name that depend on
+//! the authenticated SteamID alone, never on the name a client sends.
+//!
+//! The UUID is the mod's own: a version-3 UUID (Java's
+//! `UUID.nameUUIDFromBytes`) of `e4steam:steam-identity:v1:<steam id>`, so a
+//! world a guest's progress was saved under through the Java mod maps to the
+//! same UUID here. The safe name is `s_` + the SteamID in base 36, which
+//! fits Minecraft's name rules (16 letters, digits and underscores) and is
+//! what the guest logs in as ([guard](crate::guard) checks it on the host).
+
+use horizon_protocol::crypto::md5;
+use steamworks::SteamId;
+
+const UUID_NAMESPACE: &str = "e4steam:steam-identity:v1:";
+const NAME_PREFIX: &str = "s_";
+
+/// A stable, versioned Minecraft UUID for one SteamID (e4steam's
+/// `SteamMinecraftIdentity.uuid`).
+pub fn uuid(steam_id: u64) -> u128 {
+    let material = format!("{UUID_NAMESPACE}{steam_id}");
+    let mut h = md5(material.as_bytes());
+    h[6] = (h[6] & 0x0f) | 0x30;
+    h[8] = (h[8] & 0x3f) | 0x80;
+    u128::from_be_bytes(h)
+}
+
+/// The UUID as players and servers write it.
+pub fn uuid_string(steam_id: u64) -> String {
+    horizon_protocol::crypto::uuid_string(uuid(steam_id))
+}
+
+/// A Minecraft-compatible name derived from the SteamID (e4steam's
+/// `safeName`): the Steam persona name is shown nowhere it would be trusted.
+pub fn safe_name(steam_id: u64) -> String {
+    format!("{NAME_PREFIX}{}", base36(steam_id))
+}
+
+/// The SteamID a safe name carries, for the host's join check.
+pub fn steam_id_of(name: &str) -> Option<u64> {
+    let id = name.strip_prefix(NAME_PREFIX)?;
+    // A u64 in base 36 is at most 13 digits ("s_" + 13 stays within
+    // Minecraft's 16); anything longer is not one of this scheme's names.
+    if id.is_empty() || id.len() > 13 {
+        return None;
+    }
+    u64::from_str_radix(id, 36).ok()
+}
+
+/// The safe name a guest over Steam must log in with.
+pub fn expected_name(steam_id: SteamId) -> String {
+    safe_name(steam_id.raw())
+}
+
+fn base36(mut n: u64) -> String {
+    const DIGITS: &[u8; 36] = b"0123456789abcdefghijklmnopqrstuvwxyz";
+    if n == 0 {
+        return "0".into();
+    }
+    let mut out = Vec::new();
+    while n > 0 {
+        out.push(DIGITS[(n % 36) as usize]);
+        n /= 36;
+    }
+    out.reverse(); // Java's Long.toString writes the high digit first
+    String::from_utf8(out).unwrap()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Vectors computed against the Java algorithm
+    /// (`UUID.nameUUIDFromBytes("e4steam:steam-identity:v1:" + id)` and
+    /// `Long.toString(id, 36)`), e4steam's `SteamMinecraftIdentity`.
+    #[test]
+    fn matches_the_java_mods_derivation() {
+        for (steam_id, uuid, name) in [
+            (
+                76561197960265728,
+                "6dd93370-5365-38a4-9daa-17484fc197fc",
+                "s_kxuogshzmyo",
+            ),
+            (
+                12345678901234567,
+                "9cfb726f-27f4-385e-8602-fff058d4a4b6",
+                "s_3dk6el9t85j",
+            ),
+        ] {
+            assert_eq!(uuid_string(steam_id), uuid);
+            assert_eq!(safe_name(steam_id), name);
+            assert_eq!(steam_id_of(name), Some(steam_id));
+            // The derived UUID is a v3 one, like Java's nameUUIDFromBytes.
+            assert_eq!(&uuid[14..15], "3");
+        }
+    }
+
+    #[test]
+    fn a_safe_name_is_a_legal_minecraft_name() {
+        for id in [1, 480, 76561197960265728, u64::MAX] {
+            let name = safe_name(id);
+            assert!(name.len() <= 16, "{name} is too long");
+            assert!(
+                name.chars().all(|c| c.is_ascii_alphanumeric() || c == '_'),
+                "{name} holds an illegal character"
+            );
+            assert_eq!(steam_id_of(&name), Some(id));
+        }
+    }
+
+    #[test]
+    fn other_names_carry_no_steam_id() {
+        for name in ["", "s_", "s", "s_", "Steve", "s_zzzzzzzzzzzzzzzzzzz", "S_1"] {
+            assert_eq!(steam_id_of(name), None, "{name} parsed");
+        }
+    }
+}
diff --git a/crates/horizon-steam/src/lib.rs b/crates/horizon-steam/src/lib.rs
new file mode 100644
index 000000000..059319553
--- /dev/null
+++ b/crates/horizon-steam/src/lib.rs
@@ -0,0 +1,213 @@
+//! Play with Steam friends: e4steam's multiplayer, ported to Horizon.
+//!
+//! e4steam is a Java mod (Fabric / Forge / NeoForge) that opens a singleplayer
+//! world to Steam friends without port forwarding; Java mod jars do not run on
+//! Horizon, so this crate brings what it does natively: the host creates a
+//! Steam lobby behind its world, friends join from a Steam invite or the
+//! lobby's address, and the game's stream travels over Steam's encrypted P2P
+//! networking between the two ends of the integrated server — the same shape
+//! as Play with Friends ([horizon_friends]), with Steam as the transport.
+//!
+//! What is carried over from the mod, and how:
+//!
+//! - **App ID 480.** e4steam permanently uses Valve's shared test App ID
+//!   (Spacewar) so no Steam app of its own is needed, and filters unrelated
+//!   App ID 480 traffic. So does this port: the lobby holds Horizon's own
+//!   metadata keys (below) and a join is refused when they are missing, so a
+//!   lobby from any other App ID 480 program is not joinable by mistake.
+//! - **Access modes.** A *Steam friends* lobby (friends join freely) or an
+//!   *invitation only* one (joining needs the host's invite), like the mod's
+//!   "Open to LAN → Steam friends" and "Invitation only".
+//! - **Identity.** e4steam 0.3.0 derives each guest's stable Minecraft
+//!   identity from the authenticated SteamID instead of trusting the name the
+//!   client sends. This port keeps the mod's scheme ([identity]): the name
+//!   `s_<steamid in base 36>` and the UUID the mod derives for the SteamID.
+//!   The host's tunnel checks the name the guest logs in with against its
+//!   Steam connection's identity and refuses a mismatch, so a guest cannot
+//!   join under another name than its Steam account's ([guard]).
+//! - **Virtual port 480** for the listen socket, as the mod's dedicated
+//!   transport uses.
+//!
+//! Not ported (yet): the dedicated-server Steam mode (the mod's anonymous
+//! GameServer sign-in and `d-...steam` addresses) and the UDP voice-chat
+//! bridge (Horizon has no Java voice mods). The `steamworks` crate version
+//! and this crate's lobby keys are not shared with the Java mod: a Java
+//! e4steam host and a Horizon guest cannot interop (Horizon cannot run the
+//! mod's Java code either way).
+//!
+//! [horizon_friends]: https://docs.rs/horizon-friends
+pub mod guard;
+pub mod guest;
+pub mod identity;
+pub mod share;
+
+use steamworks::Client;
+
+/// Steam's shared test App ID (Spacewar), as e4steam uses.
+pub const APP_ID: u32 = 480;
+/// The virtual port of the host's P2P listen socket (e4steam's own).
+pub const VIRTUAL_PORT: i32 = 480;
+/// The address prefix a guest pastes: `steam:<lobby id>` (the host's screen
+/// shows and copies it).
+pub const ADDRESS_PREFIX: &str = "steam:";
+/// Lobby metadata: the game's protocol number, as e4steam keys its lobbies.
+pub const LOBBY_KEY_PROTOCOL: &str = "horizon_protocol";
+/// Lobby metadata: the game's version name, for the mismatch message.
+pub const LOBBY_KEY_GAME: &str = "horizon_game";
+/// Lobby metadata: the host's SteamID (where the P2P connection goes).
+pub const LOBBY_KEY_HOST: &str = "horizon_host";
+/// Guests at once, like the integrated server's own limit.
+pub const MAX_GUESTS: usize = 8;
+/// Lobby members at once (the host is one of them).
+pub const MAX_LOBBY_MEMBERS: u32 = MAX_GUESTS as u32 + 1;
+
+/// Something the Steam runtime told us, on the callback thread.
+#[derive(Clone, Copy, Debug)]
+pub enum SteamEvent {
+    /// A lobby's membership changed (`LobbyChatUpdate`).
+    LobbyMemberChanged {
+        lobby: u64,
+        member: u64,
+        entered: bool,
+    },
+    /// The player accepted a Steam invite while the game runs
+    /// (`GameLobbyJoinRequested`): the lobby to join.
+    JoinRequested { lobby: u64 },
+}
+
+/// The process's Steam runtime: the client and the thread that pumps its
+/// callbacks. One per process; acquired on demand and never shut down (the
+/// game ends with the process).
+pub struct Steam {
+    client: Client,
+    subscribers: std::sync::Mutex<Vec<std::sync::mpsc::Sender<SteamEvent>>>,
+}
+
+static RUNTIME: std::sync::OnceLock<Result<std::sync::Arc<Steam>, String>> =
+    std::sync::OnceLock::new();
+
+/// The runtime, started on first use: `Err` when Steam isn't running or its
+/// API refused us (the message is for the player, in e4steam's
+/// troubleshooting spirit).
+pub fn acquire() -> Result<std::sync::Arc<Steam>, String> {
+    RUNTIME
+        .get_or_init(start)
+        .as_ref()
+        .map_err(|e| e.clone())
+        .cloned()
+}
+
+/// Whether Steam sharing can be offered (Steam is running and signed in).
+/// False without the client's `steam` feature: the runtime is not linked.
+pub fn available() -> bool {
+    acquire().is_ok()
+}
+
+/// This player's SteamID, when Steam is available.
+pub fn own_steam_id() -> Option<u64> {
+    acquire().ok().map(|s| s.client.user().steam_id().raw())
+}
+
+/// This player's persona name, when Steam is available.
+pub fn persona_name() -> Option<String> {
+    acquire().ok().map(|s| s.client.friends().name())
+}
+
+/// Receive the events Steam's callbacks produce (invites accepted, lobby
+/// members coming and going). Each call adds a receiver; drop it to leave.
+pub fn subscribe() -> Result<std::sync::mpsc::Receiver<SteamEvent>, String> {
+    let steam = acquire()?;
+    let (tx, rx) = std::sync::mpsc::channel();
+    steam.subscribers.lock().unwrap().push(tx);
+    Ok(rx)
+}
+
+fn start() -> Result<std::sync::Arc<Steam>, String> {
+    // App ID 480 without a steam_appid.txt beside the game: the SDK reads the
+    // `SteamAppId` environment variable, which `init_app` sets.
+    let client = Client::init_app(APP_ID)
+        .map_err(|e| format!("Steam isn't running, or refused Horizon ({e}). Start Steam and sign in, then restart the game."))?;
+    let steam = std::sync::Arc::new(Steam {
+        client,
+        subscribers: std::sync::Mutex::new(Vec::new()),
+    });
+    // One thread pumps every callback, all the time: lobby results, invites
+    // and the networking sockets' connection events are delivered during it.
+    std::thread::Builder::new()
+        .name("horizon-steam-callbacks".into())
+        .spawn({
+            let steam = steam.clone();
+            move || loop {
+                steam.client.run_callbacks();
+                std::thread::sleep(std::time::Duration::from_millis(10));
+            }
+        })
+        .map_err(|e| format!("Steam's callback thread could not start: {e}"))?;
+    steam.client.register_callback({
+        let steam = steam.clone();
+        move |update: steamworks::LobbyChatUpdate| {
+            steam.announce(SteamEvent::LobbyMemberChanged {
+                lobby: update.lobby.raw(),
+                member: update.user_changed.raw(),
+                entered: update.member_state_change == steamworks::ChatMemberStateChange::Entered,
+            });
+        }
+    });
+    steam.client.register_callback({
+        let steam = steam.clone();
+        move |requested: steamworks::GameLobbyJoinRequested| {
+            // The player accepted an invite in the overlay; the client's
+            // Steam screen turns it into a join.
+            steam.announce(SteamEvent::JoinRequested {
+                lobby: requested.lobby_steam_id.raw(),
+            });
+        }
+    });
+    log::info!(
+        "Steam is ready: app id {APP_ID}, persona '{}'",
+        persona_name().unwrap_or_default()
+    );
+    Ok(steam)
+}
+
+impl Steam {
+    /// Send an event to every subscriber.
+    pub(crate) fn announce(&self, event: SteamEvent) {
+        self.subscribers
+            .lock()
+            .unwrap()
+            .retain(|tx| tx.send(event).is_ok());
+    }
+    pub(crate) fn client(&self) -> &Client {
+        &self.client
+    }
+}
+
+/// The address a host's lobby is joined by: `steam:<lobby id>`.
+pub fn lobby_address(lobby: u64) -> String {
+    format!("{ADDRESS_PREFIX}{lobby}")
+}
+
+/// The lobby id in a `steam:<lobby id>` address.
+pub fn parse_lobby_address(address: &str) -> Option<u64> {
+    address
+        .strip_prefix(ADDRESS_PREFIX)
+        .and_then(|id| id.trim().parse().ok())
+        .filter(|id| *id != 0)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn lobby_addresses_round_trip() {
+        let id = 109775241234567890;
+        assert_eq!(parse_lobby_address(&lobby_address(id)), Some(id));
+        assert_eq!(parse_lobby_address("steam: 109775241234567890"), Some(id));
+        assert_eq!(parse_lobby_address("steam:0"), None);
+        assert_eq!(parse_lobby_address("steam:"), None);
+        assert_eq!(parse_lobby_address("steam:none"), None);
+        assert_eq!(parse_lobby_address("friend:K7QM-3XPD"), None);
+    }
+}
diff --git a/crates/horizon-steam/src/share.rs b/crates/horizon-steam/src/share.rs
new file mode 100644
index 000000000..cdd739539
--- /dev/null
+++ b/crates/horizon-steam/src/share.rs
@@ -0,0 +1,435 @@
+//! The host's Steam share: a lobby carries the invite (Steam friends join
+//! freely, or only by invitation), a P2P listen socket carries the game.
+//! Every guest's connection is checked ([guard](crate::guard)) and then
+//! pumped to the integrated server's loopback port byte for byte, as Play
+//! with Friends carries its sessions: the server never sees the difference.
+//! Steam encrypts the transport; identity is the Steam account.
+use crate::{
+    MAX_GUESTS, VIRTUAL_PORT,
+    guard::{self, Opening},
+    identity,
+};
+use std::{
+    collections::HashMap,
+    io::{self, Read, Write},
+    net::{Shutdown, SocketAddr, TcpStream},
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicBool, Ordering},
+        mpsc::{Receiver, Sender, channel},
+    },
+    thread::JoinHandle,
+    time::{Duration, Instant},
+};
+use steamworks::networking_sockets::NetConnection;
+use steamworks::networking_types::{
+    AppNetConnectionEnd, ListenSocketEvent, NetConnectionEnd, NetworkingConnectionState,
+    NetworkingMessage,
+};
+use steamworks::{LobbyId, LobbyType, SteamId};
+
+/// Who may join.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Access {
+    /// Steam friends join freely (e4steam's "Steam friends").
+    Friends,
+    /// Joining needs the host's invitation (e4steam's "Invitation only";
+    /// invitations go through the Steam overlay).
+    Invitation,
+}
+
+/// How the share is set up.
+pub struct ShareConfig {
+    /// The integrated server's loopback address (Open to LAN's port).
+    pub lan: SocketAddr,
+    /// The game's protocol number: a guest's lobby check refuses a mismatch
+    /// before any connection is made.
+    pub protocol: i32,
+    /// The game's version name, for the same message.
+    pub game: String,
+    pub access: Access,
+}
+
+/// What the host's game shows.
+#[derive(Clone, Debug, Default)]
+pub struct ShareState {
+    /// The lobby's address (`steam:<id>`), once Steam made the lobby.
+    pub address: Option<String>,
+    /// The safe names of the guests being carried.
+    pub guests: Vec<String>,
+    /// Why Steam sharing isn't serving, when the player asked for it.
+    pub problem: Option<String>,
+}
+
+/// What the share reports, polled like a tick.
+#[derive(Debug)]
+pub enum ShareEvent {
+    /// The lobby is ready (its address).
+    Lobby(String),
+    /// A guest's session is being carried.
+    GuestJoined { steam_id: u64 },
+    /// The guest's session ended.
+    GuestLeft { steam_id: u64 },
+}
+
+struct Inner {
+    config: ShareConfig,
+    lobby: Mutex<Option<LobbyId>>,
+    listen: Mutex<Option<steamworks::networking_sockets::ListenSocket>>,
+    events: Mutex<Sender<ShareEvent>>,
+    state: Mutex<ShareState>,
+    guests: Mutex<HashMap<u64, ()>>,
+    stop: AtomicBool,
+}
+
+impl Inner {
+    fn emit(&self, event: ShareEvent) {
+        let _ = self.events.lock().unwrap().send(event);
+    }
+    /// Whether the Steam account may connect now: room at the server and a
+    /// seat in the lobby (which Steam fills by friendship or invitation,
+    /// whichever the host chose).
+    fn admitted(&self, steam: &crate::Steam, id: SteamId) -> bool {
+        self.guests.lock().unwrap().len() < MAX_GUESTS && self.is_member(steam, id)
+    }
+    fn is_member(&self, steam: &crate::Steam, id: SteamId) -> bool {
+        self.lobby.lock().unwrap().is_some_and(|lobby| {
+            steam
+                .client()
+                .matchmaking()
+                .lobby_members(lobby)
+                .contains(&id)
+        })
+    }
+}
+
+/// The host's end, like `horizon_friends::Host`: started in the background,
+/// the game polls it.
+pub struct Share {
+    inner: Arc<Inner>,
+    events: Receiver<ShareEvent>,
+    threads: Mutex<Vec<JoinHandle<()>>>,
+}
+
+impl Share {
+    /// Start sharing: create the lobby (a few seconds at most), publish the
+    /// address, listen for friends on virtual port 480.
+    pub fn start(config: ShareConfig) -> Result<Self, String> {
+        let steam = crate::acquire()?;
+        let client = steam.client();
+        let (tx, events) = channel();
+        let (created, created_rx) = channel();
+        let ty = match config.access {
+            Access::Friends => LobbyType::FriendsOnly,
+            Access::Invitation => LobbyType::Private,
+        };
+        client
+            .matchmaking()
+            .create_lobby(ty, crate::MAX_LOBBY_MEMBERS, move |r| {
+                let _ = created.send(r);
+            });
+        let lobby = created_rx
+            .recv_timeout(Duration::from_secs(10))
+            .map_err(|_| "Steam didn't answer the lobby request".to_owned())?
+            .map_err(|e| format!("Steam refused the lobby ({e}). Restart Steam and try again."))?;
+        let host = client.user().steam_id();
+        let mm = client.matchmaking();
+        mm.set_lobby_data(
+            lobby,
+            crate::LOBBY_KEY_PROTOCOL,
+            &config.protocol.to_string(),
+        );
+        mm.set_lobby_data(lobby, crate::LOBBY_KEY_GAME, &config.game);
+        mm.set_lobby_data(lobby, crate::LOBBY_KEY_HOST, &host.raw().to_string());
+        if !mm.set_lobby_joinable(lobby, true) {
+            return Err("Steam wouldn't make the lobby joinable".into());
+        }
+        let listen = client
+            .networking_sockets()
+            .create_listen_socket_p2p(VIRTUAL_PORT, [])
+            .map_err(|_| "Steam wouldn't open the world's P2P listener".to_owned())?;
+        let address = crate::lobby_address(lobby.raw());
+        let inner = Arc::new(Inner {
+            config,
+            lobby: Mutex::new(Some(lobby)),
+            listen: Mutex::new(Some(listen)),
+            events: Mutex::new(tx),
+            state: Mutex::new(ShareState {
+                address: Some(address.clone()),
+                ..ShareState::default()
+            }),
+            guests: Mutex::new(HashMap::new()),
+            stop: AtomicBool::new(false),
+        });
+        inner.emit(ShareEvent::Lobby(address));
+        let service = std::thread::Builder::new()
+            .name("horizon-steam-share".into())
+            .spawn({
+                let inner = inner.clone();
+                move || serve(inner, steam)
+            })
+            .map_err(|e| format!("Steam sharing's thread could not start: {e}"))?;
+        Ok(Self {
+            inner,
+            events,
+            threads: Mutex::new(vec![service]),
+        })
+    }
+
+    pub fn state(&self) -> ShareState {
+        self.inner.state.lock().unwrap().clone()
+    }
+    pub fn poll(&self) -> Vec<ShareEvent> {
+        self.events.try_iter().collect()
+    }
+    /// The guests being carried over Steam.
+    pub fn sessions(&self) -> usize {
+        self.inner.guests.lock().unwrap().len()
+    }
+    /// Open the Steam overlay's invite dialog for the lobby.
+    pub fn invite_friends(&self) -> Result<(), String> {
+        let lobby = self
+            .inner
+            .lobby
+            .lock()
+            .unwrap()
+            .ok_or_else(|| "The Steam lobby is gone".to_owned())?;
+        invite_friends_overlay(lobby);
+        Ok(())
+    }
+    /// End the share: leave the lobby, close the listener. Sessions already
+    /// playing go on until the integrated server closes them, as Play with
+    /// Friends' stop does.
+    pub fn stop(&self) {
+        self.inner.stop.store(true, Ordering::Relaxed);
+        // Dropping the listen socket rejects new connections at once.
+        *self.inner.listen.lock().unwrap() = None;
+        if let Some(lobby) = self.inner.lobby.lock().unwrap().take()
+            && let Ok(steam) = crate::acquire()
+        {
+            steam.client().matchmaking().leave_lobby(lobby);
+        }
+        for t in self.threads.lock().unwrap().drain(..) {
+            let _ = t.join();
+        }
+    }
+}
+
+/// The service loop: accept the lobby's friends, hand each connected guest
+/// to its bridge, stop when the share does.
+fn serve(inner: Arc<Inner>, steam: Arc<crate::Steam>) {
+    while !inner.stop.load(Ordering::Relaxed) {
+        let event = inner
+            .listen
+            .lock()
+            .unwrap()
+            .as_ref()
+            .and_then(|l| l.try_receive_event());
+        match event {
+            Some(ListenSocketEvent::Connecting(request)) => {
+                let remote = request.remote().steam_id();
+                if remote.is_some_and(|id| inner.admitted(&steam, id)) {
+                    // Failures surface through Disconnected.
+                    let _ = request.accept();
+                } else {
+                    let _ = request.reject(
+                        NetConnectionEnd::App(AppNetConnectionEnd::generic_normal()),
+                        Some("Horizon: the world is full, or you were not invited"),
+                    );
+                    if remote.is_some() {
+                        log::info!("Steam share: refused a guest who has no seat in the lobby");
+                    }
+                }
+            }
+            Some(ListenSocketEvent::Connected(connected)) => {
+                if let Some(id) = connected.remote().steam_id() {
+                    let raw = id.raw();
+                    let mut guests = inner.guests.lock().unwrap();
+                    if guests.len() < MAX_GUESTS && guests.insert(raw, ()).is_none() {
+                        drop(guests);
+                        spawn_bridge(&inner, raw, connected.take_connection());
+                        inner.emit(ShareEvent::GuestJoined { steam_id: raw });
+                    }
+                }
+            }
+            _ => {}
+        }
+        std::thread::sleep(Duration::from_millis(10));
+    }
+}
+
+/// One guest: check its opening (its first bytes prove it logs in as its
+/// Steam account), then carry the stream between Steam and the integrated
+/// server until either side ends it.
+fn spawn_bridge(inner: &Arc<Inner>, steam_id: u64, conn: NetConnection) {
+    let inner = inner.clone();
+    let started = std::thread::Builder::new()
+        .name("horizon-steam-guest".into())
+        .spawn(move || bridge(inner, steam_id, conn));
+    if let Err(e) = started {
+        log::warn!("Steam share: a guest's bridge could not start: {e}");
+    }
+}
+
+/// How long a guest has to send a proper opening.
+const OPENING: Duration = Duration::from_secs(10);
+/// How much of the game's stream goes in one Steam message (e4steam's
+/// DATA_CHUNK_SIZE).
+const CHUNK: usize = 32 * 1024;
+
+fn bridge(inner: Arc<Inner>, steam_id: u64, mut conn: NetConnection) {
+    let end = |reason: &str| {
+        log::info!("Steam share: guest {steam_id}: {reason}");
+        let mut guests = inner.guests.lock().unwrap();
+        if guests.remove(&steam_id).is_some() {
+            inner.emit(ShareEvent::GuestLeft { steam_id });
+        }
+    };
+    // The opening: the handshake and the login's Hello, straight from the
+    // guest's first messages.
+    let mut opening = Opening::default();
+    let mut front: Vec<u8> = Vec::new();
+    let mut fed = 0usize;
+    let deadline = Instant::now() + OPENING;
+    let verdict = loop {
+        match opening.feed(&front[fed..]) {
+            Ok(verdict) => break Some(verdict),
+            Err(true) => {}
+            Err(false) => break None,
+        }
+        fed = front.len();
+        if let Some(messages) = receive(&mut conn) {
+            for message in messages {
+                front.extend_from_slice(message.data());
+            }
+        }
+        if let Some(steamworks::networking_types::NetConnectionEvent {
+            new_state:
+                NetworkingConnectionState::ClosedByPeer
+                | NetworkingConnectionState::ProblemDetectedLocally,
+            ..
+        }) = conn.try_receive_event()
+        {
+            end("hung up before logging in");
+            return;
+        }
+        if Instant::now() > deadline {
+            end("never finished logging in");
+            return;
+        }
+        std::thread::sleep(Duration::from_millis(5));
+    };
+    match verdict {
+        Some(guard::Verdict::Allowed(name)) if name == identity::safe_name(steam_id) => {}
+        other => {
+            let reason = match other {
+                Some(guard::Verdict::Refused(reason)) => reason,
+                Some(_) => "logged in under another name than its Steam account",
+                None => "sent an opening Horizon doesn't understand",
+            };
+            let _ = conn.close(
+                NetConnectionEnd::App(AppNetConnectionEnd::generic_normal()),
+                Some("Horizon: log in with the name of your Steam account"),
+                false,
+            );
+            end(reason);
+            return;
+        }
+    }
+    let Ok(mut server) = TcpStream::connect_timeout(&inner.config.lan, Duration::from_secs(5))
+    else {
+        let _ = conn.close(
+            NetConnectionEnd::App(AppNetConnectionEnd::generic_exception()),
+            Some("Horizon: the world's server isn't reachable"),
+            false,
+        );
+        end("the integrated server didn't answer");
+        return;
+    };
+    let _ = server.set_nodelay(true);
+    inner
+        .state
+        .lock()
+        .unwrap()
+        .guests
+        .push(identity::safe_name(steam_id));
+    inner.emit(ShareEvent::GuestJoined { steam_id });
+    // The bytes read before the verdict were the guest's opening: the server
+    // still needs them.
+    if server.write_all(&front).is_err() {
+        end("the integrated server closed the connection");
+        return;
+    }
+    carry(&mut conn, &mut server);
+    let _ = server.shutdown(Shutdown::Both);
+    let name = identity::safe_name(steam_id);
+    inner.state.lock().unwrap().guests.retain(|g| *g != name);
+    end("the session ended");
+}
+
+/// The pump: Steam messages to the server, the server's bytes to Steam,
+/// until either side ends the session. One thread per guest; the game's
+/// traffic is modest, so a short poll keeps latency low without blocking
+/// reads on either side.
+fn carry(conn: &mut NetConnection, server: &mut TcpStream) {
+    let _ = server.set_nonblocking(true);
+    let mut buf = vec![0u8; CHUNK];
+    loop {
+        let mut idle = true;
+        if let Some(messages) = receive(conn) {
+            for message in messages {
+                if server.write_all(message.data()).is_err() {
+                    return;
+                }
+                idle = false;
+            }
+        }
+        if let Some(event) = conn.try_receive_event()
+            && matches!(
+                event.new_state,
+                NetworkingConnectionState::ClosedByPeer
+                    | NetworkingConnectionState::ProblemDetectedLocally
+                    | NetworkingConnectionState::None
+            )
+        {
+            return;
+        }
+        match server.read(&mut buf) {
+            Ok(0) => return,
+            Ok(n) => {
+                let Ok(_) = conn.send_message(
+                    &buf[..n],
+                    steamworks::networking_types::SendFlags::RELIABLE
+                        | steamworks::networking_types::SendFlags::NO_NAGLE,
+                ) else {
+                    return;
+                };
+                idle = false;
+            }
+            Err(e) if e.kind() == io::ErrorKind::WouldBlock => {}
+            Err(_) => return,
+        }
+        if idle {
+            std::thread::sleep(Duration::from_millis(1));
+        }
+    }
+}
+
+/// The connection's queued messages, or None when its handle is gone.
+fn receive(conn: &mut NetConnection) -> Option<Vec<NetworkingMessage>> {
+    conn.receive_messages(64).ok()
+}
+
+/// The Steam overlay's invite dialog for a lobby: the player picks friends
+/// and Steam sends the invitations, as e4steam's "Invite friends" does.
+pub(crate) fn invite_friends_overlay(lobby: LobbyId) {
+    // steamworks has no wrapper for this one; the flat C API takes the
+    // friends interface and the lobby's id.
+    unsafe {
+        let friends = steamworks::sys::SteamAPI_SteamFriends_v018();
+        steamworks::sys::SteamAPI_ISteamFriends_ActivateGameOverlayInviteDialog(
+            friends,
+            lobby.raw(),
+        );
+    }
+}
